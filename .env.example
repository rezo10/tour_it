# Copy this file to `.env.local` and fill in real values.
# After saving, restart the dev server with `npm run dev`.

# --- Supabase (Project Settings → API in the Supabase Dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Google Gemini (Google AI Studio — server-only, used by /api/itinerary) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a specific model instead of the auto-fallback chain.
# Default chain: gemini-2.5-flash-lite → gemini-2.5-flash → gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Mapbox (public token for the planner map) ---
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- OpenWeather (utility page weather card) ---
OPENWEATHER_API_KEY=

# --- Optional: Foursquare (reserved for future POI lookups) ---
FOURSQUARE_API_KEY=
