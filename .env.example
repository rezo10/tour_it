# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Gemini (Google AI Studio) — sadece sunucu (/api/itinerary) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Boş bırakılırsa API sırayla dener: gemini-2.5-flash-lite → 2.5-flash → 2.0-flash
# Tek model zorunlu ise:
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- OpenWeather (utility) ---
OPENWEATHER_API_KEY=

# --- Foursquare (isteğe bağlı) ---
FOURSQUARE_API_KEY=
